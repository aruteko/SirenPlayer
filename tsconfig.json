{
	"extends": "expo/tsconfig.base",
	"compilerOptions": {
		"strict": true,
		"skipLibCheck": true,
		"paths": {
			"@/*": ["./src/*"],
			"@siren/audio": ["./modules/siren-audio/index.ts"],
			"@siren/theme-colors": ["./modules/image-theme-colors/index.ts"]
		}
	},
	"include": [
		"src/**/*.ts",
		"src/**/*.tsx",
		"modules/**/*.ts",
		"app.config.ts",
		".expo/types/**/*.ts",
		"expo-env.d.ts"
	],
	"exclude": ["node_modules"]
}
